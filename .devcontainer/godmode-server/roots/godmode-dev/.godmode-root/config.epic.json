{
  "description": "An epic overseer: runs an epic's sub-issues on its own epic branch, with the fleet's tools",
  "fleetTools": true,
  "allowSkipPermissions": false,
  "scriptsCreateFolder": true,
  "create": "epic/create",
  "nameTemplate": "epic_{issueNumber}",
  "claudeArgs": ["--settings", "{\"crossSessionInbound\":\"accept\"}", "--allowedTools", "mcp__godmode-fleet", "mcp__godmode__message_parent"]
}
