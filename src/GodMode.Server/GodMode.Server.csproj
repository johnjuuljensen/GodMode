<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>eff7560e-7e44-46f7-b010-7ca1368e1689</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GodMode.Server.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CliWrap" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.File" />
    <!--<PackageReference Include="Microsoft.AspNetCore.SignalR" Version="1.1.0" />-->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GodMode.ProjectFiles\GodMode.ProjectFiles.csproj" />
    <ProjectReference Include="..\GodMode.Shared\GodMode.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- ── React client build (same pattern as GodMode.Maui) ──── -->

  <PropertyGroup>
    <_ReactDir>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '..', 'GodMode.Client.React'))</_ReactDir>
  </PropertyGroup>

  <!-- Track React sources for incremental build -->
  <ItemGroup>
    <_ReactSource Include="$(_ReactDir)\src\**\*" />
    <_ReactSource Include="$(_ReactDir)\index.html" />
    <_ReactSource Include="$(_ReactDir)\package.json" />
    <_ReactSource Include="$(_ReactDir)\vite.config.ts" />
    <_ReactSource Include="$(_ReactDir)\tsconfig*.json" />
  </ItemGroup>

  <!-- ── Hub types for the React client ─────────────────────────
       tools/GodMode.TypeGen writes signalr/generated/hub-types.ts from GodMode.Shared on every
       build, before the client builds, so the client compiles against the contract as it is. It
       rewrites the file only when its text changes, which keeps BuildReact incremental. The file is
       committed so `npm run dev` needs no .NET build, and a hand edit is undone by the next build. -->

  <PropertyGroup>
    <_HubTypesFile>$(_ReactDir)\src\signalr\generated\hub-types.ts</_HubTypesFile>
  </PropertyGroup>

  <!-- Only when the client is built here: the Dockerfile builds it on its own and copies no tools/ -->
  <ItemGroup Condition="'$(PublishReactClient)' != 'false'">
    <ProjectReference Include="..\..\tools\GodMode.TypeGen\GodMode.TypeGen.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <Target Name="GenerateHubTypes"
          BeforeTargets="BuildReact"
          DependsOnTargets="ResolveProjectReferences"
          Condition="'$(PublishReactClient)' != 'false'">
    <!-- ResolveProjectReferences built it but keeps no output of a ReferenceOutputAssembly="false"
         reference, so ask it for its path, with the properties that build used -->
    <MSBuild Projects="@(_MSBuildProjectReferenceExistent)"
             Condition="'%(Filename)' == 'GodMode.TypeGen'"
             Targets="GetTargetPath"
             Properties="%(_MSBuildProjectReferenceExistent.SetConfiguration); %(_MSBuildProjectReferenceExistent.SetPlatform); %(_MSBuildProjectReferenceExistent.SetTargetFramework)"
             RemoveProperties="%(_MSBuildProjectReferenceExistent.GlobalPropertiesToRemove)$(_GlobalPropertiesToRemoveFromProjectReferences)">
      <Output TaskParameter="TargetOutputs" ItemName="_TypeGenAssembly" />
    </MSBuild>
    <Error Condition="'@(_TypeGenAssembly)' == ''" Text="GodMode.TypeGen was not built; cannot generate the client's hub types." />
    <Exec Command="dotnet &quot;@(_TypeGenAssembly)&quot; &quot;$(_HubTypesFile)&quot;" />
  </Target>

  <!-- Build React and copy to wwwroot (incremental: skipped when sources unchanged). Its packages
       are installed first when they are missing, as in a fresh clone (the codespace's publish) -->
  <Target Name="BuildReact"
          BeforeTargets="PrepareForBuild"
          Condition="'$(PublishReactClient)' != 'false'"
          Inputs="@(_ReactSource)"
          Outputs="$(_ReactDir)\dist\index.html">
    <Message Importance="high" Text="Building React client..." />
    <Exec Command="npm ci" WorkingDirectory="$(_ReactDir)" Condition="!Exists('$(_ReactDir)\node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="$(_ReactDir)" />
  </Target>

  <Target Name="CopyReactToWwwroot"
          DependsOnTargets="BuildReact"
          BeforeTargets="PrepareForBuild"
          Condition="'$(PublishReactClient)' != 'false'"
          Inputs="$(_ReactDir)\dist\index.html"
          Outputs="wwwroot\index.html">
    <ItemGroup>
      <_ReactDist Include="$(_ReactDir)\dist\**" />
    </ItemGroup>
    <Copy SourceFiles="@(_ReactDist)"
          DestinationFiles="@(_ReactDist->'wwwroot\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
