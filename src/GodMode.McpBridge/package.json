{
  "name": "@godmode/mcp-bridge",
  "version": "1.0.0",
  "description": "GodMode MCP Bridge — lets Claude interact with GodMode (submit results, update status, request reviews, ask for permission)",
  "type": "module",
  "main": "dist/godmode-mcp-bridge.cjs",
  "bin": {
    "godmode-mcp-bridge": "dist/godmode-mcp-bridge.cjs"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && esbuild src/index.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/godmode-mcp-bridge.cjs",
    "start": "node dist/godmode-mcp-bridge.cjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.0"
  }
}
