<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework />
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx'))">$(TargetFrameworks);net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>GodMode.Maui</RootNamespace>
		<MauiXamlInflator>SourceGen</MauiXamlInflator>
		<WindowsPackageType>None</WindowsPackageType>

		<!-- App metadata -->
		<ApplicationTitle>GodMode</ApplicationTitle>
		<ApplicationId>com.godmode.maui</ApplicationId>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- Platform minimum versions -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.19041.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.19041.0</TargetPlatformMinVersion>

		<_ReactDir>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '..', 'GodMode.Client.React'))</_ReactDir>

	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" VersionOverride="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" />

		<!-- The app icon: the voice prompt on a transparent layer. Windows keeps it transparent, for a light or dark
		     taskbar. Android's adaptive icon puts it on a plain near-black and shrinks it into the launcher's safe zone,
		     the centre 66 of 108 dp (the prompt's rounded corners reach 0.59 of the canvas) -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg">
			<Color Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">#121212</Color>
			<ForegroundScale Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">0.56</ForegroundScale>
		</MauiIcon>

		<!-- wwwroot/ is the React client, added from its dist/ below. Builds before #219 copied it here and never
		     removed an old bundle, so a checkout can still hold copies that must not ship -->
		<MauiAsset Include="Resources\Raw\**" Exclude="Resources\Raw\wwwroot\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\GodMode.Shared\GodMode.Shared.csproj" />
		<ProjectReference Include="..\GodMode.ClientBase\GodMode.ClientBase.csproj" />
		<ProjectReference Include="..\SignalR.Proxy\SignalR.Proxy.csproj" />
		<ProjectReference Include="..\GodMode.Voice\GodMode.Voice.csproj" />
	</ItemGroup>

	<!-- The microphone and speaker for voice: Windows only (issue #285). From the VoiceBot submodule -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
		<ProjectReference Include="..\..\external\VoiceBot\src\Providers\VoiceBot.Providers.Windows\VoiceBot.Providers.Windows.csproj" />
	</ItemGroup>

	<!-- The React client: GodMode.Client.React.csproj builds it into dist/, once per build for every target
	     framework here and GodMode.Server alike -->
	<ItemGroup>
		<ProjectReference Include="..\GodMode.Client.React\GodMode.Client.React.csproj"
		                  ReferenceOutputAssembly="false" Private="false" />
	</ItemGroup>

	<!-- The app serves dist/ itself as wwwroot/, not a copy of it: the target frameworks here build in parallel,
	     and their copies into one folder would collide. ResolveProjectReferences builds the client (incremental:
	     skipped when sources unchanged). A static glob would run before that, so a new bundle (a new hashed file
	     name) would reach the app only on the next build, and this one would ship an index.html naming a missing script.
	     Before ProcessMauiAssets too, which turns MauiAsset items into the app's content: the Apple SDKs collect bundle
	     resources, and so run it, before PrepareForBuild -->
	<Target Name="AddReactAssets"
	        DependsOnTargets="ResolveProjectReferences"
	        BeforeTargets="ProcessMauiAssets;PrepareForBuild">
		<ItemGroup>
			<_ReactAsset Include="$(_ReactDir)\dist\**" />
			<MauiAsset Include="@(_ReactAsset)" LogicalName="wwwroot\%(_ReactAsset.RecursiveDir)%(_ReactAsset.Filename)%(_ReactAsset.Extension)" />
		</ItemGroup>
	</Target>

	<!-- Windows: Resizetizer's appicon.ico holds one 64 px image, which Windows rescales for the title bar, the taskbar and
	     Explorer. This packs the sizes Resizetizer renders from the same SVG into one .ico and makes it the exe's icon;
	     the window takes its icon from the exe (MauiWinUIWindow.SetIcon) -->
	<Target Name="PackAppIcon"
	        Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'"
	        AfterTargets="ResizetizeImages"
	        Inputs="@(_AppIconPng)"
	        Outputs="$(_AppIconFile)"
	        DependsOnTargets="_GetAppIconPngs">
		<PackIco Pngs="@(_AppIconPng)" Ico="$(_AppIconFile)" />
		<ItemGroup>
			<FileWrites Include="$(_AppIconFile)" />
		</ItemGroup>
	</Target>

	<Target Name="_GetAppIconPngs">
		<PropertyGroup>
			<_AppIconFile>$(IntermediateOutputPath)GodMode.ico</_AppIconFile>
			<ApplicationIcon>$(_AppIconFile)</ApplicationIcon>
		</PropertyGroup>
		<ItemGroup>
			<_AppIconPng Include="$(_MauiIntermediateImages)appiconLogo.altform-unplated_targetsize-16.png;
			                      $(_MauiIntermediateImages)appiconLogo.altform-unplated_targetsize-24.png;
			                      $(_MauiIntermediateImages)appiconLogo.altform-unplated_targetsize-32.png;
			                      $(_MauiIntermediateImages)appiconLogo.altform-unplated_targetsize-48.png;
			                      $(_MauiIntermediateImages)appiconLogo.altform-unplated_targetsize-256.png" />
		</ItemGroup>
	</Target>

	<!-- An .ico of PNG images, one per size (Windows Vista and later read PNG entries) -->
	<UsingTask TaskName="PackIco" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
		<ParameterGroup>
			<Pngs ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
			<Ico ParameterType="System.String" Required="true" />
		</ParameterGroup>
		<Task>
			<Code Type="Fragment" Language="cs"><![CDATA[
var images = Pngs.Select(p => File.ReadAllBytes(p.ItemSpec)).ToArray();
using var w = new BinaryWriter(File.Create(Ico));
w.Write((short)0); w.Write((short)1); w.Write((short)images.Length);
var offset = 6 + 16 * images.Length;
foreach (var png in images)
{
    // The width and height sit big-endian at bytes 16 and 20 of a PNG's IHDR; 0 in an .ico entry means 256
    int Side(int at) => (png[at] << 24) | (png[at + 1] << 16) | (png[at + 2] << 8) | png[at + 3];
    w.Write((byte)(Side(16) % 256)); w.Write((byte)(Side(20) % 256));
    w.Write((byte)0); w.Write((byte)0); w.Write((short)1); w.Write((short)32);
    w.Write(png.Length); w.Write(offset);
    offset += png.Length;
}
foreach (var png in images)
    w.Write(png);
]]></Code>
		</Task>
	</UsingTask>

</Project>
