<Project Sdk="Microsoft.Build.NoTargets/3.7.134">

  <!-- ── The React client's build ───────────────────────────────
       Builds the client into dist/, which GodMode.Server copies into its wwwroot and GodMode.Maui
       packages. They reference this project instead of each running `npm run build`. MSBuild builds a
       project once per set of global properties, and a reference asks with the same set from every
       project and target framework, so a solution build runs one `npm run build`, not several whose
       Vite empties dist/ under the others (#219). -->

  <PropertyGroup>
    <!-- Nothing here is compiled, and a default glob would walk node_modules on every evaluation -->
    <EnableDefaultItems>false</EnableDefaultItems>
    <!-- A build that only computes outputs (a design-time build, or the pass Android makes over a MAUI
         build per runtime identifier) reaches this project with other global properties, so as a
         second instance of it. It must write nothing, or the race is back. -->
    <_BuildReactClient Condition="'$(SkipCompilerExecution)' != 'true'">true</_BuildReactClient>
  </PropertyGroup>

  <!-- Track React sources for incremental build -->
  <ItemGroup>
    <_ReactSource Include="src\**\*" />
    <_ReactSource Include="index.html" />
    <_ReactSource Include="package.json" />
    <_ReactSource Include="vite.config.ts" />
    <_ReactSource Include="tsconfig*.json" />
  </ItemGroup>

  <!-- ── Hub types ──────────────────────────────────────────────
       tools/GodMode.TypeGen writes signalr/generated/hub-types.ts from GodMode.Shared on every
       build, before the client builds, so the client compiles against the contract as it is. It
       rewrites the file only when its text changes, which keeps BuildReact incremental. The file is
       committed so `npm run dev` needs no .NET build, and a hand edit is undone by the next build. -->

  <PropertyGroup>
    <_HubTypesFile>$(MSBuildProjectDirectory)\src\signalr\generated\hub-types.ts</_HubTypesFile>
    <!-- The dotnet running this build, which the CLI puts in DOTNET_HOST_PATH, rather than whichever
         is first on PATH. A build without it (Visual Studio's MSBuild) falls back to PATH. -->
    <_DotnetHost>$(DOTNET_HOST_PATH)</_DotnetHost>
    <_DotnetHost Condition="'$(_DotnetHost)' == ''">dotnet</_DotnetHost>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\tools\GodMode.TypeGen\GodMode.TypeGen.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <Target Name="GenerateHubTypes"
          BeforeTargets="BuildReact"
          DependsOnTargets="ResolveProjectReferences"
          Condition="'$(_BuildReactClient)' == 'true'">
    <!-- ResolveProjectReferences built it but keeps no output of a ReferenceOutputAssembly="false"
         reference, so ask it for its path, with the properties that build used -->
    <MSBuild Projects="@(_MSBuildProjectReferenceExistent)"
             Condition="'%(Filename)' == 'GodMode.TypeGen'"
             Targets="GetTargetPath"
             Properties="%(_MSBuildProjectReferenceExistent.SetConfiguration); %(_MSBuildProjectReferenceExistent.SetPlatform); %(_MSBuildProjectReferenceExistent.SetTargetFramework)"
             RemoveProperties="%(_MSBuildProjectReferenceExistent.GlobalPropertiesToRemove)$(_GlobalPropertiesToRemoveFromProjectReferences)">
      <Output TaskParameter="TargetOutputs" ItemName="_TypeGenAssembly" />
    </MSBuild>
    <Error Condition="'@(_TypeGenAssembly)' == ''" Text="GodMode.TypeGen was not built; cannot generate the client's hub types." />
    <Exec Command="&quot;$(_DotnetHost)&quot; &quot;@(_TypeGenAssembly)&quot; &quot;$(_HubTypesFile)&quot;" />
  </Target>

  <!-- Build the client (incremental: skipped when sources unchanged). Its packages are installed
       first when they are missing, as in a fresh clone (the codespace's publish). It runs after
       Build but within it: a referencing project's request for Build returns once this is done -->
  <Target Name="BuildReact"
          AfterTargets="Build"
          Condition="'$(_BuildReactClient)' == 'true'"
          Inputs="@(_ReactSource)"
          Outputs="dist\index.html">
    <Message Importance="high" Text="Building React client..." />
    <Exec Command="npm ci" Condition="!Exists('node_modules')" />
    <Exec Command="npm run build" />
  </Target>

</Project>
