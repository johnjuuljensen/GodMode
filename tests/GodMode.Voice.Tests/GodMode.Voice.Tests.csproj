<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GodMode.Voice\GodMode.Voice.csproj" />
    <!-- The end-to-end test launches the real server from this output directory, and it launches the fake claude -->
    <ProjectReference Include="..\..\src\GodMode.Server\GodMode.Server.csproj" />
    <ProjectReference Include="..\GodMode.FakeClaude\GodMode.FakeClaude.csproj" />
    <!-- VoiceBot's session test doubles, from the submodule -->
    <ProjectReference Include="..\..\external\VoiceBot\src\VoiceBot.Testing\VoiceBot.Testing.csproj" />
  </ItemGroup>

  <!-- The Windows app's headset buttons, call and media sessions (issues #423, #442): their pure logic, compiled in from their source, so these run on any
       OS without the MAUI app. Windows' own sessions behind it are the user's to try by hand -->
  <ItemGroup>
    <Compile Include="..\..\src\GodMode.Maui\Platforms\Windows\HeadsetButtons.cs" Link="Maui\HeadsetButtons.cs" />
    <Compile Include="..\..\src\GodMode.Maui\Platforms\Windows\HeadsetCall.cs" Link="Maui\HeadsetCall.cs" />
    <Compile Include="..\..\src\GodMode.Maui\Platforms\Windows\MediaSessionTracker.cs" Link="Maui\MediaSessionTracker.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="VoiceBot.Testing" />
  </ItemGroup>

</Project>
