<Project Sdk="Microsoft.NET.Sdk">

  <!-- The headset spike's pure logic (tools/GodMode.HeadsetSpike), compiled in from its source so these run on any OS
       without the WinForms app: the gesture classifier. The rest of the spike is manual (its README's trial). -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\tools\GodMode.HeadsetSpike\GestureClassifier.cs" Link="GestureClassifier.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
