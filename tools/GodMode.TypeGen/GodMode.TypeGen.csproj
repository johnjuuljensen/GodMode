<Project Sdk="Microsoft.NET.Sdk">

  <!-- Writes the React client's hub types (src/GodMode.Client.React/src/signalr/generated/hub-types.ts)
       from GodMode.Shared. GodMode.Server runs it on every build, before it builds the client. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GodMode.Shared\GodMode.Shared.csproj" />
  </ItemGroup>

</Project>
